{
  "name": "octopus-agent-app",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p desktop",
    "build": "npm run typecheck && vite build desktop",
    "desktop:build": "node scripts/build-desktop.mjs",
    "release:assets": "node scripts/release-assets.mjs",
    "import-history": "node scripts/import-history.mjs",
    "start": "node scripts/server.mjs",
    "test": "node --test scripts/mcp-integration.test.mjs scripts/mcp-stdio.test.mjs scripts/capability-installer.test.mjs scripts/public-release.test.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@personal-agent/core": "file:vendor/personal-agent-core-0.4.0.tgz",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "dompurify": "3.3.1",
    "marked": "17.0.1",
    "typebox": "1.3.27",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
